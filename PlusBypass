local function showMainFrame()
	local showInfo = TweenInfo.new(0.6, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out)
	TweenService:Create(mainFrame, showInfo, {BackgroundTransparency = 0.05}):Play()
	TweenService:Create(uiStroke, showInfo, {Transparency = 0}):Play()
	TweenService:Create(aiNameLabel, showInfo, {TextTransparency = 0}):Play()
	TweenService:Create(closeButton, showInfo, {TextTransparency = 0, BackgroundTransparency = 0}):Play()
end

local function typeWriter(text, speed)
	for i = 1, #text do
		messageLabel.Text = string.sub(text, 1, i)
		task.wait(speed or 0.02)
	end
end

local function animatedThinking()
	local dots = {"", ".", "..", "..."}
	local startTime = tick()
	while tick() - startTime < 1.5 do
		for _, d in ipairs(dots) do
			messageLabel.Text = "생각 중" .. d
			task.wait(0.3)
		end
	end
end

task.spawn(function()
	task.wait(0.5)
	showMainFrame()
	task.wait(0.4)
	
	typeWriter("이 게임의 안티치트를 탐지하겠습니다.", 0.03)
	
	task.wait(1.0)
	
	animatedThinking()
	
	messageLabel.Text = "잠시 생각함"
	task.wait(1.0)
	
	messageLabel.Text = "안티치트 탐지 중"
	
	local allDescendants = game:GetDescendants()
	local totalCount = #allDescendants
	local batchSize = math.ceil(totalCount / 5)
	local currentIndex = 1
	
	local detectedAnticheat = false
	local detectedTechniques = {}
	
	local scanConnection
	scanConnection = RunService.Heartbeat:Connect(function()
		if currentIndex <= totalCount then
			local endIndex = math.min(currentIndex + batchSize - 1, totalCount)
			for i = currentIndex, endIndex do
				local obj = allDescendants[i]
				if obj and (obj:IsA("LocalScript") or obj:IsA("ModuleScript")) then
					local nameLower = obj.Name:lower()
					if nameLower:match("anti") or nameLower:match("cheat") or nameLower:match("detect") or nameLower:match("protect") then
						detectedAnticheat = true
						table.insert(detectedTechniques, "스크립트 시그니처 감지 (" .. obj.Name .. ")")
					end
				end
			end
			currentIndex = endIndex + 1
		end
	end)
	
	local scanStartTime = tick()
	while tick() - scanStartTime < 5.0 do
		task.wait(1.0)
	end
	
	if scanConnection then
		scanConnection:Disconnect()
	end
	
	pcall(function()
		for _, obj in ipairs(getgc(true)) do
			if typeof(obj) == "table" then
				if rawget(obj, "Kick") or rawget(obj, "Ban") or rawget(obj, "Detection") then
					detectedAnticheat = true
					table.insert(detectedTechniques, "가비지 컬렉터 내부 안티치트 훅/루틴 발견")
					break
				end
			end
		end
	end)
	
	messageLabel.Text = "안티치트 탐지 완료"
	task.wait(1.0)
	
	local bypassMethod = "안티치트 환경 무력화 (Metatable Hooking & GC Function Spoofing)"
	if not detectedAnticheat then
		bypassMethod = "불필요 (실행 중인 커스텀 안티치트 없음, 기본 가상환경 안전 모드 적용)"
	end
	
	pcall(function()
		local mt = getrawmetatable(game)
		setreadonly(mt, false)
		local oldIndex = mt.__index
		mt.__index = newcclosure(function(self, k)
			if tostring(k):lower():match("kick") then
				return function() end
			end
			return oldIndex(self, k)
		end)
		setreadonly(mt, true)
	end)
	
	local presenceStr = detectedAnticheat and "탐지됨 (Active)" or "감지되지 않음 (Clean)"
	local techniqueStr = #detectedTechniques > 0 and table.concat(detectedTechniques, ", ") or "표준 모니터링 루프 없음"
	
	local reportText = string.format(
		"--- [ Bypass-AI 진단 보고서 ] ---\n\n1. 안티치트 존재 여부:\n   -> %s\n\n2. 안티치트가 사용하는 기법:\n   -> %s\n\n3. 적용된 우회 방법:\n   -> %s",
		presenceStr, techniqueStr, bypassMethod
	)
	
	chatScroll.CanvasSize = UDim2.new(0, 0, 0, 200)
	typeWriter(reportText, 0.015)
end)
