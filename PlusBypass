-- 2. 가상 머신(VM) 및 디버그 후킹 무력화 레이어
-- 현대 안티치트는 debug 라이브러리를 통해 실행 중인 스크립트의 소스 코드를 역추적합니다.
do
    local debug_info = debug and debug.info
    if hookfunction and debug_info then
        local old_debug_info
        old_debug_info = hookfunction(debug_info, function(thread, f, what, ...)
            if type(f) == "function" and not checkcaller() then
                local success, res = pcall(old_debug_info, thread, f, what, ...)
                if success and type(res) == "string" then
                    -- 익스큐터나 비정상 소스 경로를 C레벨 네이티브 함수로 위장
                    if res:find("Synapse") or res:find("Scriptware") or res:find("Delta") or 
                       res:find("Fluxus") or res:find("Hydrogen") or res:find(".lua") or res:find("init") then
                        return "=[C]"
                    end
                end
                return res
            end
            return old_debug_info(thread, f, what, ...)
        end)
    end
end

-- 3. 가비지 컬렉터(GC) 스캐닝을 통한 안티치트 인스턴스/함수 무력화
-- 구버전 및 신버전 안티치트가 getgc()로 메모리 내의 함수들을 스캔하는 것을 방어합니다.
task.spawn(function()
    pcall(function()
        if getgc and hookfunction then
            for _, obj in ipairs(getgc(true)) do
                if type(obj) == "function" then
                    local success, info = pcall(debug.getinfo, obj)
                    if success and info and info.source then
                        local src = info.source:lower()
                        -- 안티치트 시그니처 감지 키워드 필터링
                        if src:find("anticheat") or src:find("ac_") or src:find("detector") or 
                           src:find("integrity") or src:find("banwave") or src:find("validator") then
                            pcall(function()
                                hookfunction(obj, function(...)
                                    -- 안티치트 검증 함수가 호출될 때 무해한 참(True) 값 반환 후 탈출
                                    return true 
                                end)
                            end)
                        end
                    end
                end
            end
        end
    end)
end)

-- 4. 메타메서드 가상화 및 전역 후킹 레이어 (__namecall, __index, __newindex)
local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
local oldIndex = mt.__index
local oldNewIndex = mt.__newindex

makewriteable(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    -- 외부 주입 컨텍스트(익스큐터)에서 호출된 것이 아닐 때 (즉, 게임 내 안티치트가 호출할 때)
    if not checkcaller() then
        -- 강제 종료(Kick) 방어
        if method == "Kick" or method == "KickServer" then
            return nil
        end
        
        -- 원격 이벤트(RemoteEvent) 기반 텔레메트리 스팸 및 차단
        if method == "FireServer" or method == "InvokeServer" then
            local remoteName = tostring(self)
            -- 난독화된 원격 이름 패턴 또는 특정 검증 리포트 차단
            if #remoteName > 36 or remoteName:match("^[%w_%-%[%]]+$") == nil or 
               remoteName:lower():find("ac") or remoteName:lower():find("report") then
                return nil
            end
        end
    end
    
    return oldNamecall(self, unpack(args))
end)

mt.__index = newcclosure(function(self, k)
    if not checkcaller() then
        -- 플레이어 상태 변조 감지 속성 은닉
        if self == LocalPlayer and (k == "Character" or k == "PlayerGui" or k == "Backpack") then
            -- 내부 안티치트가 비정상 접근 시 정합성 유지
        end
    end
    return oldIndex(self, k)
end)

makewriteable(mt, true)

-- 5. 전역 환경 무결성 프록시 보호 (Environment Cloaking)
if getgenv and make_writeable then
    local env = getgenv()
    local sensitive_libs = {"debug", "coroutine", "table", "math"}
    
    for _, libName in ipairs(sensitive_libs) do
        local lib = env[libName]
        if type(lib) == "table" then
            env[libName] = setmetatable({}, {
                __index = lib,
                __newindex = function(t, k, v)
                    if not checkcaller() then return end
                    lib[k] = v
                end,
                __metatable = "The metatable is locked"
            })
        end
    end
end

